# Copy to .env and adjust.

# The exact origin users type in their browser (scheme + host [+ port]).
PUBLIC_ORIGIN=https://upload.example.internal

# Host folder that holds incoming/, quarantine/, tmp/ and outbox/.
# outbox/ must be the folder the diode watches, on this same filesystem.
DIODE_ROOT=/srv/diode-upload

# Interface for the published HTTPS port and the health/metrics port.
HTTPS_BIND=0.0.0.0
MONITORING_BIND=127.0.0.1

# Policies (see README).
# hold: files too large for clamd to scan wait for an operator to release
# them (README "Held files"). pass: sent flagged unscanned. reject: refused.
OVERSIZE_POLICY=hold
QUARANTINE_ENABLED=true
MAX_FILE_SIZE=50GiB

# Per-client limits (see README "Limits"). Defaults shown.
#SESSION_MAX_OPEN_BATCHES=10
#SESSION_MAX_OPEN_UPLOADS=20
#SESSION_MAX_RESERVED=100GiB
#IP_MAX_OPEN_BATCHES=30
#IP_MAX_OPEN_UPLOADS=60
#IP_MAX_RESERVED=300GiB
#UPLOAD_EXPIRY=1h
